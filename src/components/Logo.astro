---
interface Props {
  size?: number;
  withText?: boolean;
  animated?: boolean;
  href?: string | null;
}

const { size = 34, withText = true, animated = false, href = '/' } = Astro.props;
const Tag = href ? 'a' : 'div';
---

<Tag href={href ?? undefined} class="logo" aria-label="Agha Sameer — home">
  <svg
    class:list={['node-mark', { animated }]}
    width={size}
    height={size}
    viewBox="0 0 64 64"
    aria-hidden="true"
  >
    <line class="l1" x1="32" y1="10" x2="12" y2="52"></line>
    <line class="l2" x1="32" y1="10" x2="52" y2="52"></line>
    <path class="s-trace" d="M21,34 C27,41 37,27 43,34" pathLength="1"></path>
    <circle class="core pop" cx="32" cy="10" r="4"></circle>
    <circle class="pop" cx="12" cy="52" r="4"></circle>
    <circle class="pop" cx="52" cy="52" r="4"></circle>
    <circle class="pop" cx="21" cy="34" r="3.5"></circle>
    <circle class="pop" cx="43" cy="34" r="3.5"></circle>
    <circle class="pop s-mid" cx="32" cy="34" r="2.4"></circle>
  </svg>
  {withText && <span class="logo-word">Agha Sameer</span>}
</Tag>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 11px;
    text-decoration: none;
    color: var(--text);
  }

  .node-mark circle {
    fill: var(--surface-2);
    stroke: var(--accent);
    stroke-width: 2;
  }
  .node-mark circle.core {
    fill: var(--accent);
    stroke: none;
  }
  .node-mark circle.s-mid {
    fill: var(--accent);
    stroke: none;
  }
  .node-mark line,
  .node-mark path {
    stroke: var(--accent-dim);
    stroke-width: 1.6;
    fill: none;
  }
  .node-mark path.s-trace {
    stroke: var(--accent);
    stroke-width: 2;
  }

  .node-mark.animated line,
  .node-mark.animated path {
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
    pathLength: 1;
    animation: draw-line 1s ease-out forwards;
  }
  .node-mark.animated path.s-trace {
    animation-delay: 0.35s;
    animation-duration: 0.8s;
  }
  .node-mark.animated circle.pop {
    transform-origin: center;
    transform-box: fill-box;
    animation: pop-in 0.4s ease-out backwards;
    animation-delay: 0.5s;
  }
  .node-mark.animated circle.core.pop {
    animation-delay: 0.9s;
    animation-duration: 0.5s;
  }
  .node-mark.animated circle.s-mid.pop {
    animation-delay: 1s;
  }
  @keyframes draw-line {
    to { stroke-dashoffset: 0; }
  }
  @keyframes pop-in {
    from { transform: scale(0); opacity: 0; }
    to { transform: scale(1); opacity: 1; }
  }
  @media (prefers-reduced-motion: reduce) {
    .node-mark.animated line,
    .node-mark.animated path,
    .node-mark.animated circle {
      animation: none;
      stroke-dashoffset: 0;
    }
  }

  .logo-word {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 16px;
    letter-spacing: -0.01em;
    white-space: nowrap;
  }
</style>
