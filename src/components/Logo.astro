---
interface Props {
  size?: number;
  withText?: boolean;
  animated?: boolean;
  href?: string | null;
}

const { size = 34, withText = true, animated = false, href = '/' } = Astro.props;
const Tag = href ? 'a' : 'div';
---

<Tag href={href ?? undefined} class="logo" aria-label="Agha Sameer — home">
  <span class:list={['mark', { animated }]} style={`width:${size}px;height:${size}px`}>
    <span class="letter">A</span>
  </span>
  {withText && <span class="logo-word">Agha Sameer</span>}
</Tag>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 11px;
    text-decoration: none;
    color: var(--text);
  }

  .mark {
    position: relative;
    flex-shrink: 0;
    border-radius: 28%;
    background: linear-gradient(135deg, var(--accent) 0%, var(--accent-dim) 100%);
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 1px 0 rgba(255, 255, 255, 0.18) inset, 0 6px 14px -8px rgba(232, 163, 61, 0.55);
  }

  .letter {
    font-family: var(--font-display);
    font-weight: 700;
    color: var(--accent-ink);
    font-size: 62%;
    line-height: 1;
    letter-spacing: -0.02em;
    transform: translateY(-2%);
  }

  .mark.animated {
    animation: mark-in 0.5s cubic-bezier(0.2, 0.8, 0.2, 1) backwards;
  }
  @keyframes mark-in {
    from { transform: scale(0.6); opacity: 0; }
    to { transform: scale(1); opacity: 1; }
  }
  @media (prefers-reduced-motion: reduce) {
    .mark.animated {
      animation: none;
    }
  }

  .logo-word {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 16px;
    letter-spacing: -0.01em;
    white-space: nowrap;
  }
</style>
