---
interface Props {
  size?: number;
  withText?: boolean;
  animated?: boolean;
  href?: string | null;
}

const { size = 34, withText = true, animated = false, href = '/' } = Astro.props;
const Tag = href ? 'a' : 'div';
const h = Math.round(size * (64 / 96));
---

<Tag href={href ?? undefined} class="logo" aria-label="Agha Sameer — home">
  <svg
    class:list={['logo-mark', { animated }]}
    width={size}
    height={h}
    viewBox="0 0 96 64"
    aria-hidden="true"
  >
    <!-- A -->
    <line class="l1" x1="23" y1="10" x2="8" y2="54"></line>
    <line class="l2" x1="23" y1="10" x2="38" y2="54"></line>
    <line class="l3" x1="14" y1="36" x2="32" y2="36"></line>
    <circle class="core" cx="23" cy="10" r="4"></circle>
    <circle cx="8" cy="54" r="4"></circle>
    <circle cx="38" cy="54" r="4"></circle>
    <circle cx="14" cy="36" r="3"></circle>
    <circle cx="32" cy="36" r="3"></circle>

    <!-- S -->
    <path class="s-trace" d="M74,12 C60,12 60,30 70,32 C80,34 80,52 66,52" pathLength="1"></path>
    <circle class="s-node" cx="74" cy="12" r="4"></circle>
    <circle class="s-node" cx="70" cy="32" r="3"></circle>
    <circle class="s-node" cx="66" cy="52" r="4"></circle>
  </svg>
  {withText && <span class="logo-word">Agha Sameer</span>}
</Tag>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    text-decoration: none;
    color: var(--text);
  }

  .logo-mark circle {
    fill: var(--surface-2);
    stroke: var(--accent);
    stroke-width: 2;
  }
  .logo-mark circle.core {
    fill: var(--accent);
    stroke: none;
  }
  .logo-mark circle.s-node {
    fill: var(--accent);
    stroke: none;
  }
  .logo-mark line {
    stroke: var(--accent-dim);
    stroke-width: 2.2;
  }
  .logo-mark path.s-trace {
    stroke: var(--accent);
    stroke-width: 2.6;
    fill: none;
    stroke-linecap: round;
  }

  .logo-mark.animated line,
  .logo-mark.animated path {
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
    pathLength: 1;
    animation: draw-line 0.7s ease-out forwards;
  }
  .logo-mark.animated path.s-trace {
    animation-delay: 0.45s;
    animation-duration: 0.9s;
  }
  .logo-mark.animated circle {
    transform-origin: center;
    transform-box: fill-box;
    animation: pop-in 0.35s ease-out backwards;
    animation-delay: 0.4s;
  }
  .logo-mark.animated circle.core {
    animation-delay: 0s;
  }
  .logo-mark.animated circle.s-node {
    animation-delay: 0.9s;
  }

  @keyframes draw-line {
    to { stroke-dashoffset: 0; }
  }
  @keyframes pop-in {
    from { transform: scale(0); opacity: 0; }
    to { transform: scale(1); opacity: 1; }
  }
  @media (prefers-reduced-motion: reduce) {
    .logo-mark.animated line,
    .logo-mark.animated path,
    .logo-mark.animated circle {
      animation: none;
      stroke-dashoffset: 0;
    }
  }

  .logo-word {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 16px;
    letter-spacing: -0.01em;
    white-space: nowrap;
  }
</style>
