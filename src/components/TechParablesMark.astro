---
interface Props {
  size?: number;
}
const { size = 48 } = Astro.props;
const h = Math.round(size * (64 / 96));
---

<svg class="tp-mark" width={size} height={h} viewBox="0 0 96 64" aria-hidden="true">
  <!-- T -->
  <line x1="10" y1="10" x2="34" y2="10"></line>
  <line x1="22" y1="10" x2="22" y2="54"></line>
  <circle class="core" cx="22" cy="10" r="4"></circle>
  <circle cx="10" cy="10" r="3"></circle>
  <circle cx="34" cy="10" r="3"></circle>
  <circle cx="22" cy="54" r="4"></circle>

  <!-- P -->
  <line x1="62" y1="10" x2="62" y2="54"></line>
  <path class="loop" d="M62,10 C82,10 82,28 62,28"></path>
  <circle class="core" cx="62" cy="10" r="4"></circle>
  <circle cx="62" cy="28" r="3"></circle>
  <circle cx="62" cy="54" r="4"></circle>
</svg>

<style>
  .tp-mark line {
    stroke: var(--accent-dim);
    stroke-width: 2.2;
  }
  .tp-mark path.loop {
    stroke: var(--accent);
    stroke-width: 2.6;
    fill: none;
    stroke-linecap: round;
  }
  .tp-mark circle {
    fill: var(--surface-2);
    stroke: var(--accent);
    stroke-width: 2;
  }
  .tp-mark circle.core {
    fill: var(--accent);
    stroke: none;
  }
</style>
