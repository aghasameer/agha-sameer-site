---
interface Props {
  size?: number;
}
const { size = 48 } = Astro.props;
---

<span class="tp-mark" style={`width:${size}px;height:${size}px`}>
  <span class="letters">T<span class="dot">·</span>P</span>
</span>

<style>
  .tp-mark {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    border-radius: 28%;
    background: linear-gradient(135deg, var(--accent) 0%, var(--accent-dim) 100%);
    box-shadow: 0 1px 0 rgba(255, 255, 255, 0.18) inset, 0 6px 14px -8px rgba(232, 163, 61, 0.55);
  }
  .letters {
    font-family: var(--font-display);
    font-weight: 700;
    color: var(--accent-ink);
    font-size: 36%;
    letter-spacing: -0.02em;
  }
  .letters .dot {
    opacity: 0.6;
    margin: 0 0.5px;
  }
</style>
