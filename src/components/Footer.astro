---
import { BookOpen, Send } from '@lucide/astro';
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container-wide inner">
    <div class="left">
      <span class="kicker">Agha Sameer</span>
      <p>CTO, Zadip Group — Riyadh, Saudi Arabia</p>
    </div>
    <div class="links">
      <a href="https://www.linkedin.com/in/aghasameer/" target="_blank" rel="noopener noreferrer">
        <svg width="14" height="14" viewBox="0 0 24 24" aria-hidden="true"><path d="M20.45 20.45h-3.55v-5.57c0-1.33-.02-3.03-1.85-3.03-1.85 0-2.14 1.45-2.14 2.94v5.66H9.36V9h3.41v1.56h.05c.47-.9 1.63-1.85 3.36-1.85 3.6 0 4.27 2.37 4.27 5.45v6.29zM5.34 7.43a2.06 2.06 0 1 1 0-4.12 2.06 2.06 0 0 1 0 4.12zM7.12 20.45H3.56V9h3.56v11.45z" fill="currentColor"/></svg>
        LinkedIn
      </a>
      <a href="/tech-parables/"><BookOpen size={14} strokeWidth={2} /> Tech Parables</a>
      <a href="/contact/"><Send size={14} strokeWidth={2} /> Contact</a>
    </div>
  </div>
  <div class="container-wide fine-print mono">© {year} Agha Sameer. All opinions my own, all bugs somebody else's.</div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--border-soft);
    margin-top: 96px;
    padding-block: 36px 24px;
  }

  .inner {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    flex-wrap: wrap;
    gap: 24px;
  }

  .left p {
    margin-top: 8px;
    color: var(--text-muted);
    font-size: 13.5px;
  }

  .links {
    display: flex;
    gap: 20px;
    font-family: var(--font-mono);
    font-size: 12.5px;
  }

  .links a {
    text-decoration: none;
    color: var(--text-muted);
    transition: color 0.15s ease;
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }
  .links a :global(svg) {
    color: var(--accent);
  }

  .links a:hover {
    color: var(--accent);
  }

  .fine-print {
    margin-top: 28px;
    font-size: 11px;
    color: var(--text-faint);
  }
</style>
