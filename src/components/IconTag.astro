---
interface Props {
  icon?: string; // Font Awesome class, e.g. "fa-solid fa-cloud"
  label: string;
  accent?: boolean;
}
const { icon, label, accent = false } = Astro.props;
---

<span class:list={['icon-tag', { accent }]}>
  {icon && <i class={icon} aria-hidden="true"></i>}
  {label}
</span>

<style>
  .icon-tag {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    font-family: var(--font-mono);
    font-size: 11.5px;
    color: var(--text-muted);
    border: 1px solid var(--border);
    background: var(--surface);
    border-radius: 999px;
    padding: 6px 13px;
    line-height: 1;
  }
  .icon-tag i {
    color: var(--accent);
    font-size: 11px;
  }
  .icon-tag.accent {
    border-color: var(--accent-dim);
    color: var(--text);
  }
</style>
