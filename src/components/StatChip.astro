---
interface Props {
  icon: string; // Font Awesome class
  value: string;
  label: string;
}
const { icon, value, label } = Astro.props;
---

<div class="stat-chip">
  <i class={icon} aria-hidden="true"></i>
  <div>
    <div class="value mono">{value}</div>
    <div class="label mono">{label}</div>
  </div>
</div>

<style>
  .stat-chip {
    display: flex;
    align-items: center;
    gap: 12px;
  }
  .stat-chip i {
    font-size: 17px;
    color: var(--accent);
    width: 22px;
    text-align: center;
    flex-shrink: 0;
  }
  .value {
    font-size: 17px;
    color: var(--text);
    font-weight: 500;
  }
  .label {
    font-size: 10.5px;
    color: var(--text-faint);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-top: 2px;
  }
</style>
