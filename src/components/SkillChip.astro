---
interface Props {
  icon: string; // Font Awesome class, e.g. "fa-brands fa-react"
  label: string;
}
const { icon, label } = Astro.props;
---

<span class="skill-chip mono">
  <i class={icon} aria-hidden="true"></i>
  {label}
</span>

<style>
  .skill-chip {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    font-size: 12px;
    color: var(--text-muted);
    border: 1px solid var(--border);
    background: var(--surface);
    border-radius: 999px;
    padding: 6px 13px 6px 11px;
    transition: border-color 0.15s ease, color 0.15s ease;
  }
  .skill-chip:hover {
    border-color: var(--accent-dim);
    color: var(--text);
  }
  .skill-chip i {
    color: var(--accent);
    font-size: 13px;
    width: 14px;
    text-align: center;
  }
</style>
