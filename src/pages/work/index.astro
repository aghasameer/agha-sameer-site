---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { Landmark, Boxes } from '@lucide/astro';

const caseStudies = (await getCollection('case-studies', ({ data }) => !data.draft)).sort(
  (a, b) => (a.data.order ?? 99) - (b.data.order ?? 99)
);
const products = (await getCollection('products', ({ data }) => !data.draft)).sort(
  (a, b) => (a.data.order ?? 99) - (b.data.order ?? 99)
);

// Real figures only, pulled from the content files above — nothing invented.
const reach = [
  { name: "King Khalid Int'l Airport — speakers reached", value: '720,000+', w: 100 },
  { name: 'Ministry of Education — employees served', value: '300,000+', w: 41.7 },
  { name: 'Nafeth — rental contracts issued', value: '200,000+', w: 27.8 },
  { name: 'Ektefa — active users', value: '70,000+', w: 9.7 },
  { name: 'Muqeem — companies & organizations', value: '26,000+', w: 4.5 },
];
---

<BaseLayout
  title="Work"
  description="Case studies and products — seventeen years delivering national-scale government and enterprise programs, from airport operations to platforms serving 700,000+ users and $5.33M in annual revenue."
>
  <section class="intro container">
    <p class="kicker">Work</p>
    <h1>Case studies &amp; products</h1>
    <p class="lede">
      Two kinds of proof: products I built and still run at Zadip Group —
      generating $5.33M a year and serving 700,000+ users — and case studies
      from programs delivered for government ministries and major enterprise
      clients.
    </p>
  </section>

  <section class="reach container-wide">
    <div class="list-head">
      <h2>Reach, by the numbers</h2>
      <p class="note mono">real figures, pulled from the work below</p>
    </div>
    <div class="reach-list">
      {reach.map((r) => (
        <div class="reach-row">
          <div class="head">
            <span class="name">{r.name}</span>
            <span class="val mono">{r.value}</span>
          </div>
          <div class="bar-track"><div class="bar-fill" style={`--w:${r.w}%`}></div></div>
        </div>
      ))}
    </div>
  </section>

  <section class="list container-wide">
    <div class="list-head">
      <h2><Landmark size={16} strokeWidth={2} /> Case studies</h2>
    </div>
    <div class="grid">
      {caseStudies.map((cs) => (
        <a href={`/work/case-studies/${cs.id}/`} class="card">
          <p class="client mono">{cs.data.client}</p>
          <h3>{cs.data.title}</h3>
          {cs.data.tags && cs.data.tags.length > 0 && (
            <div class="tag-row">
              {cs.data.tags.slice(0, 3).map((t: string) => <span class="pill mono">{t}</span>)}
            </div>
          )}
          {cs.data.figures && cs.data.figures.length > 0 && (
            <p class="figure mono">{cs.data.figures[0].value} — {cs.data.figures[0].label}</p>
          )}
        </a>
      ))}
    </div>
  </section>

  <section class="list container-wide">
    <div class="list-head">
      <h2><Boxes size={16} strokeWidth={2} /> Products</h2>
    </div>
    <div class="grid">
      {products.map((p) => (
        <a href={`/work/products/${p.id}/`} class="card">
          <div class="logo-stage">
            <img src={`/logos/products/${p.id}.png`} alt={p.data.title} loading="lazy" />
          </div>
          <p class="desc">{p.data.tagline}</p>
          {p.data.tags && p.data.tags.length > 0 && (
            <div class="tag-row">
              {p.data.tags.slice(0, 3).map((t: string) => <span class="pill mono">{t}</span>)}
            </div>
          )}
          {p.data.figures && p.data.figures.length > 0 && (
            <p class="figure mono">{p.data.figures[0].value} — {p.data.figures[0].label}</p>
          )}
        </a>
      ))}
    </div>
  </section>
</BaseLayout>

<script>
  const reachList = document.querySelector('.reach-list');
  if (reachList && !window.matchMedia('(prefers-reduced-motion: reduce)').matches && 'IntersectionObserver' in window) {
    const obs = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          reachList.classList.add('in-view');
          obs.disconnect();
        }
      });
    }, { threshold: 0.3 });
    obs.observe(reachList);
  } else if (reachList) {
    reachList.classList.add('in-view');
  }
</script>

<style>
  .intro {
    padding-block: 64px 40px;
  }
  .intro h1 {
    font-size: clamp(28px, 4.2vw, 38px);
  }
  .intro .lede {
    margin-top: 16px;
    max-width: 64ch;
    color: var(--text-muted);
    line-height: 1.7;
  }

  .reach {
    padding-block: 40px;
    border-top: 1px solid var(--border-soft);
  }
  .reach .list-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 14px;
    flex-wrap: wrap;
    margin-bottom: 24px;
  }
  .reach .list-head h2 {
    font-size: 19px;
  }
  .reach .note {
    font-size: 11.5px;
    color: var(--text-faint);
  }
  .reach-list {
    display: flex;
    flex-direction: column;
    gap: 18px;
  }
  .reach-row .head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    font-size: 13px;
    margin-bottom: 6px;
    gap: 10px;
  }
  .reach-row .name {
    color: var(--text-muted);
  }
  .reach-row .val {
    color: var(--accent);
    flex-shrink: 0;
    font-variant-numeric: tabular-nums;
  }
  .bar-track {
    height: 9px;
    border-radius: 5px;
    background: var(--surface-2);
    border: 1px solid var(--border-soft);
    overflow: hidden;
  }
  .bar-fill {
    height: 100%;
    min-width: 3%;
    border-radius: 5px;
    background: linear-gradient(90deg, var(--accent-dim), var(--accent));
    width: 0%;
    transition: width 1.1s cubic-bezier(0.16, 0.8, 0.3, 1);
  }
  .reach-list.in-view .bar-fill {
    width: var(--w);
  }

  .list {
    padding-block: 40px;
    border-top: 1px solid var(--border-soft);
  }
  .list-head h2 {
    font-size: 19px;
    margin-bottom: 20px;
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .list-head h2 :global(svg) {
    color: var(--accent);
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 14px;
  }
  .card {
    border: 1px solid var(--border);
    border-radius: 12px;
    background: var(--surface);
    padding: 22px;
    text-decoration: none;
    color: var(--text);
    display: flex;
    flex-direction: column;
    gap: 10px;
    transition: border-color 0.2s ease, transform 0.2s ease;
  }
  .card:hover {
    border-color: var(--accent-dim);
    transform: translateY(-2px);
  }
  .client {
    font-size: 11px;
    color: var(--text-faint);
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }
  .card h3 {
    font-size: 16.5px;
    line-height: 1.35;
  }
  .logo-stage {
    width: 100%;
    height: 44px;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .logo-stage img {
    max-height: 100%;
    max-width: 100%;
    width: auto;
    height: auto;
    object-fit: contain;
  }
  .desc {
    font-size: 13.5px;
    color: var(--text-muted);
    line-height: 1.5;
  }
  .tag-row {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }
  .pill {
    font-size: 10.5px;
    color: var(--text-faint);
    border: 1px solid var(--border);
    border-radius: 999px;
    padding: 3px 9px;
  }
  .figure {
    font-size: 11.5px;
    color: var(--accent);
    margin-top: auto;
    padding-top: 8px;
    border-top: 1px solid var(--border-soft);
  }

  @media (prefers-reduced-motion: reduce) {
    .bar-fill {
      transition: none;
    }
  }
</style>
