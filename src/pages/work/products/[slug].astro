---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const entries = await getCollection('products', ({ data }) => !data.draft);
  return entries.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const { title, tagline, stack, tags, role, figures, launched } = entry.data;
---

<BaseLayout title={title} description={`${title} — ${tagline}`}>
  <article class="container">
    <p class="kicker"><a href="/work/">Work</a> / Product</p>
    <div class="logo-stage">
      <img src={`/logos/products/${entry.id}.png`} alt={title} />
    </div>
    <p class="tagline">{tagline}{launched ? ` · live since ${launched}` : ''}</p>

    {tags && tags.length > 0 && (
      <div class="tag-row">
        {tags.map((t) => <span class="pill mono">{t}</span>)}
      </div>
    )}

    {role && (
      <p class="role">
        <i class="fa-solid fa-user-tie"></i> <strong>My role:</strong> {role}
      </p>
    )}

    {figures && figures.length > 0 && (
      <div class="figures">
        {figures.map((f) => (
          <div class="fig">
            <div class="num mono">{f.value}</div>
            <div class="label mono">{f.label}</div>
          </div>
        ))}
      </div>
    )}

    <div class="prose">
      <Content />
    </div>

    {stack && stack.length > 0 && (
      <div class="stack-block">
        <p class="stack-label mono"><i class="fa-solid fa-code"></i> Tech stack</p>
        <div class="stack">
          {stack.map((s) => (
            <span class="chip mono">{s}</span>
          ))}
        </div>
      </div>
    )}

    <a class="back" href="/work/">← Back to all work</a>
  </article>
</BaseLayout>

<style>
  article {
    padding-block: 56px 80px;
  }
  .kicker a {
    text-decoration: none;
    color: inherit;
  }
  .logo-stage {
    margin-top: 24px;
    height: 48px;
    display: flex;
    align-items: center;
  }
  .logo-stage img {
    height: 100%;
    width: auto;
    max-width: 260px;
    object-fit: contain;
    object-position: left center;
  }
  .tagline {
    margin-top: 14px;
    font-size: clamp(18px, 2.6vw, 22px);
    color: var(--text-muted);
    max-width: 48ch;
  }
  .tag-row {
    margin-top: 18px;
    display: flex;
    flex-wrap: wrap;
    gap: 7px;
  }
  .pill {
    font-size: 11px;
    color: var(--text-muted);
    border: 1px solid var(--border);
    border-radius: 999px;
    padding: 4px 11px;
  }
  .role {
    margin-top: 18px;
    font-size: 14px;
    color: var(--text-muted);
    display: flex;
    align-items: flex-start;
    gap: 9px;
    max-width: 60ch;
  }
  .role i {
    color: var(--accent);
    margin-top: 3px;
  }
  .role strong {
    color: var(--text);
    font-weight: 500;
  }
  .figures {
    margin-top: 24px;
    display: flex;
    gap: 32px;
    flex-wrap: wrap;
  }
  .fig .num {
    font-size: 24px;
    color: var(--accent);
    font-weight: 500;
  }
  .fig .label {
    font-size: 11px;
    color: var(--text-faint);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    margin-top: 4px;
  }
  .prose {
    margin-top: 32px;
    max-width: 68ch;
    color: var(--text-muted);
    line-height: 1.8;
    font-size: 16px;
  }
  .prose :global(p) {
    margin-bottom: 18px;
  }
  .prose :global(blockquote) {
    margin: 24px 0;
    padding: 16px 20px;
    border-left: 2px solid var(--accent-dim);
    background: var(--surface);
    border-radius: 0 8px 8px 0;
    color: var(--text-faint);
    font-size: 14px;
  }
  .stack-block {
    margin-top: 36px;
    padding-top: 20px;
    border-top: 1px solid var(--border-soft);
  }
  .stack-label {
    font-size: 11px;
    color: var(--text-faint);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    margin-bottom: 10px;
  }
  .stack-label i {
    color: var(--accent);
    margin-right: 4px;
  }
  .stack {
    display: flex;
    flex-wrap: wrap;
    gap: 7px;
  }
  .chip {
    font-size: 10.5px;
    color: var(--text-faint);
    border: 1px solid var(--border);
    border-radius: 999px;
    padding: 3px 10px;
  }
  .back {
    display: inline-block;
    margin-top: 40px;
    font-family: var(--font-mono);
    font-size: 12.5px;
    color: var(--accent);
    text-decoration: none;
  }
</style>
