---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { Briefcase, Send, UserRound, Layers, Landmark, BookOpen } from '@lucide/astro';

const products = (await getCollection('products', ({ data }) => !data.draft)).sort(
  (a, b) => (a.data.order ?? 99) - (b.data.order ?? 99)
);
const caseStudies = (await getCollection('case-studies', ({ data }) => !data.draft))
  .sort((a, b) => (a.data.order ?? 99) - (b.data.order ?? 99))
  .slice(0, 3);
const posts = (await getCollection('blog'))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);

---

<BaseLayout
  title="Agha Sameer"
  description="CTO at Zadip Group. Seventeen years of software leadership across government and enterprise systems serving 700,000+ users."
>
  <section class="hero container-wide">
    <div class="hero-copy">
      <p class="kicker">CTO · Zadip Group — Riyadh, Saudi Arabia</p>
      <h1>I build the digital infrastructure governments and enterprises trust to run their operations.</h1>
      <p class="lede">
        Seventeen years as a working CTO — six products generating $5.33M a
        year and serving 700,000+ users, plus delivery across sixteen
        government and enterprise engagements spanning national workforce
        systems, airport operations, and hospital infrastructure.
      </p>
      <div class="cta-row">
        <a class="cta" href="/work/"><Briefcase size={14} strokeWidth={2} /> See the work</a>
        <a class="cta ghost" href="/contact/"><Send size={14} strokeWidth={2} /> Get in touch</a>
      </div>
    </div>
    <div class="hero-photo">
      <div class="photo-frame" id="photo-frame">
        <img
          src="/images/profile.png"
          alt="Agha Sameer"
          loading="eager"
          onerror="this.closest('.photo-frame').classList.add('no-photo'); this.remove();"
        />
        <div class="photo-placeholder">
          <UserRound size={36} strokeWidth={1.5} />
          <span class="mono">Photo pending</span>
        </div>
      </div>
      <blockquote class="quote-chip">
        <span class="mark">“</span>
        How simple is simple, and what would it take?
      </blockquote>
    </div>
  </section>

  <section class="impact container-wide">
    <div class="impact-chart">
      <div class="section-eyebrow">
        <p class="kicker">Revenue brought in</p>
        <p class="note mono">2012 – 2026 · illustrative, pending real figures</p>
      </div>
      <svg class="revenue-chart" viewBox="0 0 880 290" preserveAspectRatio="xMidYMid meet" role="img" aria-label="Revenue growth from 2012 to 2026, with a slowdown in 2020 to 2021, reaching $5.33M by 2026">
        <defs>
          <linearGradient id="revFade" x1="0" y1="0" x2="0" y2="1">
            <stop offset="0%" stop-color="var(--accent)" stop-opacity="0.32"></stop>
            <stop offset="100%" stop-color="var(--accent)" stop-opacity="0"></stop>
          </linearGradient>
        </defs>
        <rect class="dip-band" x="468.5" y="30" width="114.4" height="220"></rect>
        <text class="dip-label" x="525.7" y="266">2020–21 · slowdown</text>
        <line x1="40" y1="250" x2="840" y2="250" stroke="var(--border-soft)" stroke-width="1"></line>
        <path class="area" d="M40.0,239.0 C49.5,237.2 78.1,231.7 97.1,228.0 C116.2,224.3 135.2,221.3 154.3,217.0 C173.3,212.7 192.4,207.2 211.4,202.3 C230.5,197.4 249.5,192.6 268.6,187.7 C287.6,182.8 306.7,178.5 325.7,173.0 C344.8,167.5 363.8,160.8 382.9,154.7 C401.9,148.6 421.0,135.1 440.0,136.3 C459.0,137.6 478.1,156.5 497.1,162.0 C516.2,167.5 535.2,172.4 554.3,169.3 C573.3,166.3 592.4,152.2 611.4,143.7 C630.5,135.1 649.5,126.6 668.6,118.0 C687.6,109.4 706.7,100.3 725.7,92.3 C744.8,84.4 763.8,76.6 782.9,70.3 C801.9,64.0 830.5,57.2 840.0,54.6 L840.0,250 L40.0,250 Z"></path>
        <path class="line" d="M40.0,239.0 C49.5,237.2 78.1,231.7 97.1,228.0 C116.2,224.3 135.2,221.3 154.3,217.0 C173.3,212.7 192.4,207.2 211.4,202.3 C230.5,197.4 249.5,192.6 268.6,187.7 C287.6,182.8 306.7,178.5 325.7,173.0 C344.8,167.5 363.8,160.8 382.9,154.7 C401.9,148.6 421.0,135.1 440.0,136.3 C459.0,137.6 478.1,156.5 497.1,162.0 C516.2,167.5 535.2,172.4 554.3,169.3 C573.3,166.3 592.4,152.2 611.4,143.7 C630.5,135.1 649.5,126.6 668.6,118.0 C687.6,109.4 706.7,100.3 725.7,92.3 C744.8,84.4 763.8,76.6 782.9,70.3 C801.9,64.0 830.5,57.2 840.0,54.6"></path>
        <circle class="end-dot pulse" cx="840" cy="54.6" r="5"></circle>
        <circle cx="40" cy="239" r="3.5" fill="var(--text-faint)"></circle>
        <text class="start-label" x="40" y="270" text-anchor="start">2012</text>
        <text class="axis-label" x="840" y="270" text-anchor="end">2026</text>
        <text class="end-label" x="700" y="48" text-anchor="end">$5.33M</text>
        <text class="end-sub" x="700" y="64" text-anchor="end">annual revenue, today</text>
      </svg>
    </div>
  </section>

  <section class="proof container-wide">
    <div class="proof-head">
      <h2><Layers size={16} strokeWidth={2} /> What I've actually built</h2>
      <a class="see-all" href="/work/">All the work →</a>
    </div>
    <div class="logo-strip">
      {products.map((p) => (
        <a href={`/work/products/${p.id}/`} class="logo-chip" title={p.data.tagline}>
          <img src={`/logos/products/${p.id}.png`} alt={p.data.title} loading="lazy" />
        </a>
      ))}
    </div>
  </section>

  <section class="case-teaser container-wide">
    <div class="proof-head">
      <h2><Landmark size={16} strokeWidth={2} /> Selected case studies</h2>
      <a class="see-all" href="/work/">All case studies →</a>
    </div>
    <div class="case-grid">
      {caseStudies.map((cs) => (
        <a href={`/work/case-studies/${cs.id}/`} class="case-card">
          <p class="client mono">{cs.data.client}</p>
          <h3>{cs.data.title}</h3>
          {cs.data.figures && cs.data.figures.length > 0 && (
            <p class="figure mono">{cs.data.figures[0].value} — {cs.data.figures[0].label}</p>
          )}
        </a>
      ))}
    </div>
  </section>

  <section class="parables-teaser container-wide">
    <div class="proof-head">
      <h2><BookOpen size={16} strokeWidth={2} /> From Tech Parables</h2>
      <a class="see-all" href="/tech-parables/">Visit the blog →</a>
    </div>
    <div class="case-grid">
      {posts.map((post) =>
        post.data.draft ? (
          <div class="case-card soon">
            <p class="client mono">Coming soon</p>
            <h3>{post.data.title}</h3>
            <p class="figure mono">Originally on LinkedIn — full post in progress</p>
          </div>
        ) : (
          <a href={`/tech-parables/${post.id}/`} class="case-card">
            <p class="client mono">{post.data.pubDate.toLocaleDateString('en-US', { year: 'numeric', month: 'short' })}</p>
            <h3>{post.data.title}</h3>
            <p class="figure mono">{post.data.description}</p>
          </a>
        )
      )}
    </div>
  </section>
</BaseLayout>

<script>
  if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches && 'IntersectionObserver' in window) {
    document.querySelectorAll('.revenue-chart').forEach((chart) => {
      const obs = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            chart.classList.add('in-view');
            obs.disconnect();
          }
        });
      }, { threshold: 0.3 });
      obs.observe(chart);
    });
  }
</script>

<style>
  .hero {
    padding-block: 64px 48px;
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    gap: 44px;
    align-items: center;
  }
  .hero-copy .kicker {
    margin-bottom: 18px;
  }
  .hero-copy h1 {
    font-size: clamp(28px, 3.6vw, 42px);
    line-height: 1.18;
    max-width: 22ch;
  }
  .hero-copy .lede {
    margin-top: 22px;
    max-width: 62ch;
    color: var(--text-muted);
    font-size: 16px;
    line-height: 1.7;
  }
  .cta-row {
    margin-top: 30px;
    display: flex;
    gap: 14px;
    flex-wrap: wrap;
  }
  .cta {
    font-family: var(--font-mono);
    font-size: 13px;
    text-decoration: none;
    padding: 11px 20px;
    border-radius: 7px;
    background: var(--accent);
    color: var(--accent-ink);
    font-weight: 500;
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }
  .cta.ghost {
    background: transparent;
    color: var(--text);
    border: 1px solid var(--border);
  }

  .hero-photo {
    position: relative;
  }
  .photo-frame {
    position: relative;
    aspect-ratio: 1 / 1;
    border-radius: 16px;
    overflow: hidden;
    border: 1px solid var(--border);
    background: var(--surface);
  }
  .photo-frame img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center center;
    filter: grayscale(0.55) contrast(1.08) brightness(0.92) sepia(0.12);
  }
  .photo-frame::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
    background: radial-gradient(ellipse 72% 72% at 50% 50%, transparent 30%, rgba(16, 20, 27, 0.85) 100%);
    pointer-events: none;
  }
  .photo-placeholder {
    display: none;
    position: absolute;
    inset: 0;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 12px;
    color: var(--text-faint);
    background: radial-gradient(circle at 50% 35%, var(--surface-2), var(--surface));
  }
  .photo-placeholder :global(svg) {
    color: var(--border);
  }
  .photo-placeholder span {
    font-size: 11px;
    letter-spacing: 0.04em;
  }
  .photo-frame.no-photo .photo-placeholder {
    display: flex;
  }
  .quote-chip {
    margin: 22px 0 0;
    padding-left: 20px;
    border-left: 2px solid var(--accent);
    font-family: var(--font-display);
    font-size: 17px;
    font-weight: 500;
    line-height: 1.5;
    color: var(--text);
  }
  .quote-chip .mark {
    display: block;
    font-family: Georgia, "Times New Roman", serif;
    font-size: 34px;
    line-height: 0.4;
    color: var(--accent);
    margin-bottom: 10px;
  }
  .quote-chip .attrib {
    margin-top: 10px;
    font-size: 10.5px;
    color: var(--text-faint);
    font-weight: 400;
  }

  section.impact,
  section.proof,
  section.case-teaser,
  section.parables-teaser {
    padding-block: 48px;
    border-top: 1px solid var(--border-soft);
  }

  .section-eyebrow {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 12px;
    flex-wrap: wrap;
    margin-bottom: 20px;
  }
  .section-eyebrow .note {
    font-size: 11px;
    color: var(--text-faint);
  }

  .impact-chart {
    border: 1px solid var(--border);
    border-radius: 14px;
    background: var(--surface);
    padding: 28px 28px 18px;
  }
  .revenue-chart { width: 100%; height: auto; display: block; overflow: visible; }
  .revenue-chart .dip-band { fill: var(--surface-2); }
  .revenue-chart .dip-label { font-family: var(--font-mono); font-size: 10.5px; fill: var(--text-faint); text-anchor: middle; }
  .revenue-chart .area { fill: url(#revFade); opacity: 0; transition: opacity 1.1s ease 0.2s; }
  .revenue-chart .line { stroke: var(--accent); stroke-width: 2.5; fill: none; stroke-linecap: round; stroke-dasharray: 1; stroke-dashoffset: 1; pathLength: 1; transition: stroke-dashoffset 1.8s cubic-bezier(0.16, 0.8, 0.3, 1); }
  .revenue-chart.in-view .area { opacity: 1; }
  .revenue-chart.in-view .line { stroke-dashoffset: 0; }
  .revenue-chart .axis-label, .revenue-chart .start-label { font-family: var(--font-mono); font-size: 11px; fill: var(--text-faint); }
  .revenue-chart .end-dot { fill: var(--accent); }
  .revenue-chart .end-dot.pulse { animation: node-pulse 2.4s ease-in-out infinite; }
  .revenue-chart .end-label { font-family: var(--font-mono); font-size: 17px; fill: var(--accent); font-weight: 600; }
  .revenue-chart .end-sub { font-family: var(--font-mono); font-size: 10.5px; fill: var(--text-faint); }
  @keyframes node-pulse { 0%, 100% { opacity: 0.6; } 50% { opacity: 1; } }
  @media (prefers-reduced-motion: reduce) {
    .revenue-chart .area { transition: none; opacity: 1; }
    .revenue-chart .line { transition: none; stroke-dashoffset: 0; }
    .revenue-chart .end-dot.pulse { animation: none; }
  }

  .proof-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 16px;
    flex-wrap: wrap;
    margin-bottom: 24px;
  }
  .proof-head h2 {
    font-size: 19px;
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .proof-head h2 :global(svg) {
    color: var(--accent);
  }
  .see-all {
    font-family: var(--font-mono);
    font-size: 12.5px;
    color: var(--accent);
    text-decoration: none;
  }

  .logo-strip {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
  }
  .logo-chip {
    flex: 1 1 150px;
    height: 68px;
    border: 1px solid var(--border);
    border-radius: 10px;
    background: var(--surface);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 14px;
    transition: border-color 0.2s ease, transform 0.2s ease;
  }
  .logo-chip:hover {
    border-color: var(--accent-dim);
    transform: translateY(-2px);
  }
  .logo-chip img {
    max-height: 100%;
    max-width: 100%;
    width: auto;
    height: auto;
    object-fit: contain;
  }

  .case-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(230px, 1fr));
    gap: 14px;
  }
  .case-card {
    border: 1px solid var(--border);
    border-radius: 12px;
    background: var(--surface);
    padding: 20px 22px;
    text-decoration: none;
    color: var(--text);
    display: flex;
    flex-direction: column;
    gap: 8px;
    transition: border-color 0.2s ease, transform 0.2s ease;
  }
  .case-card:hover {
    border-color: var(--accent-dim);
    transform: translateY(-2px);
  }
  .case-card.soon {
    opacity: 0.6;
  }
  .case-card.soon:hover {
    transform: none;
    border-color: var(--border);
  }
  .case-card .client {
    font-size: 11px;
    color: var(--text-faint);
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }
  .case-card h3 {
    font-size: 15.5px;
    line-height: 1.35;
  }
  .case-card .figure {
    font-size: 11.5px;
    color: var(--accent);
    margin-top: 4px;
  }

  .parables-card {
    border: 1px solid var(--border);
    border-radius: 12px;
    background: var(--surface);
    padding: 22px 24px;
    color: var(--text-muted);
    font-size: 13px;
  }

  @media (max-width: 760px) {
    .hero {
      grid-template-columns: 1fr;
    }
    .hero-photo {
      max-width: 360px;
    }
  }
</style>
