---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const products = (await getCollection('products', ({ data }) => !data.draft))
  .sort((a, b) => (a.data.order ?? 99) - (b.data.order ?? 99))
  .slice(0, 6);
---

<BaseLayout
  title="Agha Sameer"
  description="CTO at Zadip Group. Seventeen years building software that governments and enterprises actually run on."
>
  <section class="hero container">
    <p class="kicker">CTO, Zadip Group — Riyadh</p>
    <h1>
      I've shipped software for ministries, airports, and a fifty-year-old PA
      system that finally learned to behave.
    </h1>
    <p class="lede">
      Seventeen years as a working CTO — not a consultant who drops a deck and
      leaves. I build the systems that keep running long after everyone else
      has gone home, across six products of my own and a long list of
      government and enterprise deployments that, by design, nobody notices
      until they stop working.
    </p>
    <div class="cta-row">
      <a class="cta" href="/work/">See the work</a>
      <a class="cta ghost" href="/tech-parables/">Read Tech Parables</a>
    </div>
  </section>

  <section class="quote-block container">
    <!-- DRAFT — placeholder pull-quote. Swap for your own words, or edit this one. -->
    <blockquote>
      <span class="mark">“</span>
      Most software fails quietly long before it fails loudly. My job is
      making sure nobody finds out which kind we shipped.
    </blockquote>
    <p class="attrib mono">— draft quote, awaiting your edit</p>
  </section>

  <section class="proof container-wide">
    <div class="proof-head">
      <h2>What I've actually built</h2>
      <a class="see-all" href="/work/">All the work →</a>
    </div>
    <div class="logo-strip">
      {products.map((p) => (
        <a href={`/work/products/${p.id}/`} class="logo-chip" title={p.data.tagline}>
          <img src={`/logos/products/${p.id}.png`} alt={p.data.title} loading="lazy" />
        </a>
      ))}
    </div>
  </section>

  <section class="bio-teaser container">
    <h2>Seventeen years, no straight line</h2>
    <p>
      I started in call-center operations, not code — the kind of job where
      you learn that a system's worth is measured by what happens when it's
      under pressure, not by its architecture diagram. That instinct followed
      me into IT project management, then into building and running the
      product org at Zadip Group, where I still am.
    </p>
    <a class="see-all" href="/about/">The longer version →</a>
  </section>

  <section class="parables-teaser container-wide">
    <div class="parables-card">
      <div class="parables-mark">T·P</div>
      <div class="parables-copy">
        <h2>Tech Parables</h2>
        <p>Lessons from the stack, told straight — the blog is warming up. First posts incoming.</p>
      </div>
      <a class="cta ghost small" href="/tech-parables/">Visit →</a>
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    padding-block: 72px 56px;
  }
  .hero .kicker {
    margin-bottom: 18px;
  }
  .hero h1 {
    font-size: clamp(30px, 4.6vw, 44px);
    line-height: 1.18;
    max-width: 18ch;
  }
  .hero .lede {
    margin-top: 22px;
    max-width: 62ch;
    color: var(--text-muted);
    font-size: 16.5px;
    line-height: 1.7;
  }
  .cta-row {
    margin-top: 32px;
    display: flex;
    gap: 14px;
    flex-wrap: wrap;
  }
  .cta {
    font-family: var(--font-mono);
    font-size: 13px;
    text-decoration: none;
    padding: 11px 20px;
    border-radius: 7px;
    background: var(--accent);
    color: var(--accent-ink);
    font-weight: 500;
  }
  .cta.ghost {
    background: transparent;
    color: var(--text);
    border: 1px solid var(--border);
  }
  .cta.small {
    padding: 9px 16px;
  }

  .quote-block {
    padding-block: 8px 64px;
  }
  .quote-block blockquote {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(22px, 3.2vw, 30px);
    font-weight: 500;
    line-height: 1.4;
    color: var(--text);
    max-width: 44ch;
    text-wrap: balance;
  }
  .quote-block .mark {
    color: var(--accent);
    margin-right: 2px;
  }
  .quote-block .attrib {
    margin-top: 14px;
    font-size: 11.5px;
    color: var(--text-faint);
  }

  .proof {
    padding-block: 56px;
    border-top: 1px solid var(--border-soft);
  }
  .proof-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 16px;
    flex-wrap: wrap;
  }
  .proof h2 {
    font-size: 20px;
  }
  .see-all {
    font-family: var(--font-mono);
    font-size: 12.5px;
    color: var(--accent);
    text-decoration: none;
  }
  .logo-strip {
    margin-top: 28px;
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
  }
  .logo-chip {
    border: 1px solid var(--border);
    border-radius: 10px;
    background: var(--surface);
    padding: 16px 22px;
    display: flex;
    align-items: center;
    transition: border-color 0.2s ease, transform 0.2s ease;
  }
  .logo-chip:hover {
    border-color: var(--accent-dim);
    transform: translateY(-2px);
  }
  .logo-chip img {
    height: 26px;
    width: auto;
  }

  .bio-teaser {
    padding-block: 56px;
    border-top: 1px solid var(--border-soft);
  }
  .bio-teaser h2 {
    font-size: 20px;
  }
  .bio-teaser p {
    margin-top: 16px;
    max-width: 68ch;
    color: var(--text-muted);
    line-height: 1.75;
  }
  .bio-teaser .see-all {
    display: inline-block;
    margin-top: 16px;
  }

  .parables-teaser {
    padding-block: 56px 80px;
    border-top: 1px solid var(--border-soft);
  }
  .parables-card {
    border: 1px solid var(--border);
    border-radius: 14px;
    background: var(--surface);
    padding: 30px 32px;
    display: flex;
    align-items: center;
    gap: 24px;
    flex-wrap: wrap;
  }
  .parables-mark {
    width: 52px;
    height: 52px;
    border-radius: 10px;
    background: var(--accent-soft);
    border: 1px solid var(--border);
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-label);
    font-weight: 700;
    color: var(--accent);
    font-size: 14px;
    flex-shrink: 0;
  }
  .parables-copy {
    flex: 1;
    min-width: 220px;
  }
  .parables-copy h2 {
    font-size: 19px;
  }
  .parables-copy p {
    margin-top: 6px;
    color: var(--text-muted);
    font-size: 14px;
  }
</style>
